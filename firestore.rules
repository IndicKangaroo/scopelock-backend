rules_version = '2';

// Every read/write in this app goes through the backend's Firebase
// Admin SDK, which bypasses these rules entirely. Android never talks
// to Firestore directly — it only calls the backend's REST API. These
// rules exist as a safety net in case that ever changes (e.g. a future
// web app reading Firestore client-side): default-deny until a real
// need shows up, then scope a rule narrowly to that need instead of
// opening the whole database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
